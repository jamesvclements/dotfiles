*.local.json

# Skills are installed via npx during setup, not tracked in git
skills/*
!skills/.gitkeep
!skills/tweet-caption
!skills/jmsv-this-week
!skills/glaze-macos-design
!skills/lunchmoney
!skills/jmsv-pr
