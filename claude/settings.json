{
  "apiKeyHelper": "security find-generic-password -a \"$USER\" -s 'ANTHROPIC_AUTH_TOKEN' -w",
  "env": {
    "ANTHROPIC_BASE_URL": "https://ai-gateway.vercel.sh"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Read(node_modules/**)",
      "Read(*/node_modules/**)",
      "Edit",
      "Write",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(git remote *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git rev-parse *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm install *)",
      "Bash(pnpm run *)",
      "Bash(pnpm test *)",
      "Bash(pnpm install *)",
      "Bash(yarn run *)",
      "Bash(yarn test *)",
      "Bash(yarn install *)",
      "Bash(tree *)",
      "Bash(open *)",
      "Bash(gh *)",
      "Bash(claude *)",
      "Bash(agent-browser *)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/*)",
      "Read(**/.secrets/*)",
      "Read(**/secrets/*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(sudo rm -rf *)"
    ],
    "ask": [
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(docker *)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-git-push.sh",
            "if": "Bash(git push:*)",
            "statusMessage": "Checking git push target..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "slack@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "james-local": {
      "source": {
        "source": "directory",
        "path": "/Users/james/.claude/local-marketplace"
      }
    }
  },
  "effortLevel": "high",
  "fastMode": true,
  "skipDangerousModePermissionPrompt": true
}
