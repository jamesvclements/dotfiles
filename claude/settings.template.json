{
  "_doc": "Bootstrap template ONLY. setup.sh COPIES this to ~/.claude/settings.json on a fresh machine if that file does not exist, and never touches it again. ~/.claude/settings.json is intentionally NOT symlinked and NOT tracked: Claude Code rewrites it on /login, /config, model and plugin changes, so syncing it made devices with different auth (standard account login vs Vercel AI Gateway) clobber each other. Per-device keys belong in the real file, never here.",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Read(node_modules/**)",
      "Read(*/node_modules/**)",
      "Edit",
      "Write",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(git remote *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git rev-parse *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm install *)",
      "Bash(pnpm run *)",
      "Bash(pnpm test *)",
      "Bash(pnpm install *)",
      "Bash(yarn run *)",
      "Bash(yarn test *)",
      "Bash(yarn install *)",
      "Bash(tree *)",
      "Bash(open *)",
      "Bash(gh *)",
      "Bash(claude *)",
      "Bash(agent-browser *)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/*)",
      "Read(**/.secrets/*)",
      "Read(**/secrets/*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(sudo rm -rf *)"
    ],
    "ask": [
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(docker *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-git-push.sh",
            "if": "Bash(git push:*)",
            "statusMessage": "Checking git push target..."
          }
        ]
      }
    ]
  }
}
